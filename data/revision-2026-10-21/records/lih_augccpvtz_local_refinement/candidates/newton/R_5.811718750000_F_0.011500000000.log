#!/usr/bin/env python3
"""Supplemental local refinement of the audited LiH aug-cc-pVTZ run.

Read-only source results; separate, fingerprinted supplemental checkpoints.
Original quantum-chemistry solver and all numerical thresholds are unchanged.
"""
from __future__ import annotations
import argparse
import hashlib
import json
import os
from pathlib import Path
import shutil
import sys
import time
import traceback

# The unmodified engine configures BLAS/OpenMP before importing NumPy.
import lih_engine as e
import numpy as np

VERSION = 'LiH-local-refinement-v1.0-20261013'
EXPECTED_ENGINE = '15f834a365312b4271efa3643595f7ec0baa62d2704fca25148ed7fe47545df4'
EXPECTED_PARENT = 'a9c63b81faf21ad3e8e6b85318a4b783ac3b89177850d713d3b293e8fa547f62'
FACTORS = (2, 4, 8, 16, 32, 64)
# Source n=16 edge numbers, zero-based. Exchange edges plus immediate neighbours.
LOCAL_EDGES = (26, 27, 28, 45, 46, 47)
ENDPOINT = (5.95, .0115)
REPORTS = ('plan.json', 'wavefunction_sha256.json', 'loop_results.json',
           'history_results.json', 'LiH_augccpVTZ_decision.json', 'run_status.json',
           'selftest.json', 'calculation_source.py')


def read_json(path):
    return json.loads(Path(path).read_text())


def runtime():
    return {'pyscf': __import__('pyscf').__version__, 'numpy': np.__version__,
            'scipy': __import__('scipy').__version__}


def refined_path(factor):
    if factor not in (1, *FACTORS):
        raise ValueError('Unsupported refinement factor')
    base = e.coords(1., 16)
    ps = []
    for i, (a, b) in enumerate(zip(base[:-1], base[1:])):
        n = factor if i in LOCAL_EDGES else 1
        for k in range(n):
            ps.append(tuple(round(a[j] + (b[j]-a[j])*k/n, 12) for j in range(2)))
    ps.append(ps[0])
    # This balanced refinement preserves the original opposite corner exactly.
    # Never silently use half the edges as the physical endpoint on another mesh.
    mid = ps.index(ENDPOINT)
    if mid * 2 != len(ps)-1 or len(set(ps[:-1])) != len(ps)-1:
        raise RuntimeError('Invalid mesh: duplicate vertex or incorrect route split')
    if len(ps)-1 != 64 + 6*(factor-1):
        raise RuntimeError('Unexpected edge count')
    return ps


def inspect_source(source):
    """Verify the complete original archive before reusing any wavefunction."""
    if not source.is_dir():
        raise FileNotFoundError(f'Input must be an unpacked result directory: {source}')
    plan = read_json(source/'plan.json')
    if plan.get('fingerprint') != EXPECTED_PARENT:
        raise RuntimeError('This supplement targets LiH_augccpVTZ_results_20261013_022058 only.')
    calculated = hashlib.sha256(json.dumps(plan['plan'], sort_keys=True).encode()).hexdigest()
    if calculated != plan['fingerprint']:
        raise RuntimeError('Original plan fingerprint is invalid')
    if e.sha256(source/'calculation_source.py') != EXPECTED_ENGINE:
        raise RuntimeError('Original calculation source does not match the audited version')
    if e.sha256(Path(e.__file__)) != EXPECTED_ENGINE:
        raise RuntimeError('Bundled quantum-chemistry engine has been modified')
    manifest = read_json(source/'wavefunction_sha256.json')
    if len(manifest) != 736:
        raise RuntimeError('Expected the complete 736-wavefunction archive')
    for name, checksum in manifest.items():
        rel = Path(name)
        if rel.is_absolute() or '..' in rel.parts:
            raise RuntimeError('Unsafe manifest path')
        p = source/rel
        if not p.is_file() or e.sha256(p) != checksum:
            raise RuntimeError(f'Missing or changed original wavefunction: {p}')
    if {str(p.relative_to(source)) for p in source.rglob('*.npz')} != set(manifest):
        raise RuntimeError('Original directory contains unregistered wavefunctions')
    reports = {name: e.sha256(source/name) for name in REPORTS}
    decision = read_json(source/'LiH_augccpVTZ_decision.json')
    old_status = read_json(source/'run_status.json')
    if old_status.get('status') != 'COMPLETED' or decision.get('thresholds') != e.THRESHOLDS:
        raise RuntimeError('Original run is incomplete or its thresholds differ')
    sols = {}
    for key in e.coords(1., 16)[:-1]:
        s = e.load(e.outpath(source/'solutions', key))
        if s['metadata'].get('run_fingerprint') != EXPECTED_PARENT or not all(e.state_checks(s).values()):
            raise RuntimeError(f'Original boundary wavefunction is not qualified: {key}')
        sols[key] = s
    return {'plan': plan, 'manifest': manifest, 'report_hashes': reports,
            'solutions': sols, 'decision': decision,
            'runtime_matches_original': runtime() == plan['plan']['runtime_versions']}


def make_plan(info):
    return {
        'version': VERSION, 'parent_fingerprint': EXPECTED_PARENT,
        'parent_report_hashes': info['report_hashes'],
        'engine_sha256': e.sha256(Path(e.__file__)),
        'driver_sha256': e.sha256(Path(__file__)),
        'runtime_versions': runtime(), 'base_segments_per_side': 16,
        'refined_base_edges_zero_based': LOCAL_EDGES, 'refinement_factors': FACTORS,
        'endpoint_R_Angstrom_F_au': ENDPOINT,
        'thresholds': e.THRESHOLDS,
        'independent_rule': 'Two fixed RHF-seeded optimizer routes; lowest solver-valid SA4 energy, retaining both candidates.',
        'candidate_mesh_rule': 'Both adjacent refinement levels qualified, both metrics mesh-converged, every coarse-edge permutation equals its composed child-edge permutation, same composed endpoint assignment on both routes.',
        'history_rule': 'Full fresh forward/reverse traversals on each candidate fine mesh; no reuse of old history orbitals except the common independent starting seed.',
        'history_failure_rule': 'Further refine only for an assignment-only failure; stop for numerical history, wavefunction, fidelity or algebra failure.',
        'inherited_checks': 'Original global 8-to-16 mesh comparison and all four nested-loop tests are inherited after integrity verification; compare supplemental final metrics to original n=16 as well.',
        'maximum_independent_new_points': 6*(FACTORS[-1]-1),
        'no_signal_selection': 'Mesh selection uses qualification and numerical stability, never the size or sign of nonclosure.',
    }


def register_plan(root, plan):
    normalized = json.loads(json.dumps(plan))
    fingerprint = hashlib.sha256(json.dumps(normalized, sort_keys=True).encode()).hexdigest()
    target = root/'plan.json'
    if target.exists():
        previous = read_json(target)
        if previous.get('fingerprint') != fingerprint or previous.get('plan') != normalized:
            raise RuntimeError('Supplement source, runtime or plan differs from this work directory. Use a new --root; do not delete its plan.json.')
    else:
        if any(root.rglob('*.npz')):
            raise RuntimeError('Unregistered NPZ files in supplemental --root; use a new directory')
        e.write_json(target, {'fingerprint': fingerprint,
                             'created_utc': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()),
                             'plan': normalized})
    e.RUN_FINGERPRINT = fingerprint


def copy_verified(src, dest, checksum):
    if dest.exists():
        if e.sha256(dest) != checksum:
            raise RuntimeError(f'Changed local snapshot: {dest}')
    else:
        dest.parent.mkdir(parents=True, exist_ok=True)
        temp = dest.with_suffix(dest.suffix+'.copy.tmp')
        shutil.copyfile(src, temp)
        if e.sha256(temp) != checksum:
            raise RuntimeError(f'Input changed during copy: {src}')
        os.replace(temp, dest)


def freeze_baseline(source, root, info):
    for name, checksum in info['report_hashes'].items():
        copy_verified(source/name, root/'baseline'/name, checksum)
    sols = {}
    for key, state in info['solutions'].items():
        rel = 'solutions/'+Path(state['path']).name
        dest = root/'baseline'/rel
        copy_verified(source/rel, dest, info['manifest'][rel])
        sols[key] = e.load(dest)
    return sols


def analyze(ps, sols, factor):
    split = ps.index(ENDPOINT)
    if split*2 != len(ps)-1:
        raise RuntimeError('Refusing a route split that is not the physical opposite corner')
    r = e.analyze_loop(ps, sols, 1.)
    r['segments_per_side'] = None  # Mesh is nonuniform; do not mislabel it.
    r.update(base_segments_per_side=16, local_refinement_factor=factor,
             number_of_edges=len(ps)-1, endpoint_index=split,
             refined_base_edges_zero_based=list(LOCAL_EDGES))
    return r


def close_metric(fine, coarse, name):
    diff = abs(fine[name]-coarse[name])
    tol = max(e.THRESHOLDS[f'mesh_{name}_absolute_tolerance'],
              e.THRESHOLDS[f'mesh_{name}_relative_tolerance']*abs(fine[name]))
    return {'difference': diff, 'tolerance': tol, 'pass': diff <= tol}


def mesh_comparison(coarse, fine):
    oldps = [tuple(p) for p in coarse['vertices']]
    newps = [tuple(p) for p in fine['vertices']]
    positions = {p: i for i, p in enumerate(newps[:-1])}
    changed = []
    for i, (a, b) in enumerate(zip(oldps[:-1], oldps[1:])):
        left = positions[a]
        right = len(newps)-1 if i == len(oldps)-2 else positions[b]
        if right <= left:
            raise RuntimeError('Fine mesh is not an ordered refinement')
        child_perm = e.compose([ed['squared_overlap_permutation'] for ed in fine['edges'][left:right]])
        if child_perm != coarse['edges'][i]['squared_overlap_permutation']:
            changed.append({'a': a, 'b': b,
                            'coarse_permutation': coarse['edges'][i]['squared_overlap_permutation'],
                            'composed_child_permutation': child_perm})
    checks = {
        'both_levels_qualified': coarse['qualified'] and fine['qualified'],
        'C_converged': close_metric(fine, coarse, 'C')['pass'],
        'D_mu_converged': close_metric(fine, coarse, 'D_mu')['pass'],
        'edge_assignment_composition_stable': len(changed) == 0,
        'both_routes_same_assignment_both_levels': coarse['same_assignment'] and fine['same_assignment'],
    }
    return {'coarse_factor': coarse['local_refinement_factor'],
            'fine_factor': fine['local_refinement_factor'], 'checks': checks,
            'pass': all(checks.values()), 'C': close_metric(fine, coarse, 'C'),
            'D_mu': close_metric(fine, coarse, 'D_mu'), 'changed_edge_permutations': changed}


def run_histories(root, ps, sols, direct, factor, analyze_only):
    histories = []
    for name, sequence in [('forward', ps), ('reverse', list(reversed(ps)))]:
        hs = {}
        previous = sols[sequence[0]]
        label = f'refine_{factor:03d}_{name}'
        directory = root/'histories'/f'factor_{factor:03d}'/name
        for i, key in enumerate(sequence):
            state = e.get_solution(directory/f'{i:04d}.npz', key, label,
                                   previous=previous, analyze_only=analyze_only)
            if i == len(sequence)-1:
                closing = state
            else:
                hs[key] = state
            previous = state
            print(f'PROGRESS history factor={factor} {name} {i+1}/{len(sequence)}', flush=True)
        h = analyze(ps, hs, factor)
        comparisons = [{'vertex': key, **e.compare_states(sols[key], hs[key])} for key in ps[:-1]]
        closure = e.compare_states(hs[ps[0]], closing)
        h.update(history=name, closure=closure, direct_comparisons=comparisons,
                 history_direct_max_delta_E=max(c['average_energy_difference_Eh'] for c in comparisons),
                 history_direct_max_leakage=max(c['leakage'] for c in comparisons),
                 C_difference_from_direct=abs(h['C']-direct['C']),
                 D_mu_difference_from_direct=abs(h['D_mu']-direct['D_mu']))
        align = comparisons[0]['T']
        h['W_difference_after_start_frame_alignment'] = float(np.linalg.norm(direct['W']-align@h['W']@align.conj().T))
        controls = {
            'same_point_reproducibility': all(e.history_qualified(c) for c in comparisons),
            'closure': e.history_qualified(closure),
            'C_reproducibility': h['C_difference_from_direct'] <= e.THRESHOLDS['history_max_C_difference'],
            'D_mu_reproducibility': h['D_mu_difference_from_direct'] <= e.THRESHOLDS['history_max_D_mu_difference'],
            'same_composed_assignment_as_direct': h['route1_permutation'] == direct['route1_permutation']
                and h['route2_permutation'] == direct['route2_permutation'],
        }
        h['history_checks'] = controls
        h['history_pass'] = bool(h['qualified'] and all(controls.values()))
        histories.append(h)
        e.write_json(root/'analysis'/f'histories_factor_{factor:03d}.json', histories)
        print(f'HISTORY factor={factor} {name} pass={h["history_pass"]}', flush=True)
    return histories


def write_summary(root, info, baseline, loops, comparisons, histories, reason):
    last = loops[-1] if loops else baseline
    latest_comparison = comparisons[-1] if comparisons else None
    inherited = info['decision']['checks']
    same_mesh_histories = len(histories) == 2 and all(h['local_refinement_factor'] == last['local_refinement_factor'] for h in histories)
    checks = {
        'inherited_global_mesh_converged': inherited['main_mesh_converged'],
        'inherited_nested_loops_qualified': inherited['nested_loops_qualified'],
        'inherited_nested_mesh_converged': inherited['nested_mesh_converged'],
        'supplemental_finest_loop_qualified': last['qualified'],
        'adjacent_refinement_levels_stable': bool(latest_comparison and latest_comparison['pass']),
        'C_consistent_with_original_n16': close_metric(last, baseline, 'C')['pass'],
        'D_mu_consistent_with_original_n16': close_metric(last, baseline, 'D_mu')['pass'],
        'opposed_histories_qualified_on_final_mesh': bool(same_mesh_histories and all(h['history_pass'] for h in histories)),
    }
    decision = {
        'status': 'QUALIFIED' if all(checks.values()) else 'REVIEW_REQUIRED',
        'reason': reason, 'basis': e.BASIS, 'checks': checks,
        'local_refinement_factor': last['local_refinement_factor'],
        'number_of_edges': last['number_of_edges'],
        'C': last['C'], 'D_mu': last['D_mu'], 'delta_mu_au': last['delta_mu_au'],
        'eta': last['eta'], 'leakage': last['leakage'],
        'assignment_margin': last['assignment_margin'],
        'same_composed_assignment': last['same_assignment'],
        'route1_permutation': last['route1_permutation'],
        'route2_permutation': last['route2_permutation'],
        'comparison_to_original_n16': {k: close_metric(last, baseline, k) for k in ('C', 'D_mu')},
        'parent_status_preserved': info['decision']['status'],
        'parent_fingerprint': EXPECTED_PARENT, 'supplement_fingerprint': e.RUN_FINGERPRINT,
        'thresholds': e.THRESHOLDS,
        'scope': 'Finite-mesh singlet A1 SA4-CASSCF(2e,5o) transport. Dipole quantities compare transported matrix representations, not different physical endpoint dipoles. Fifth-root isolation is within singlet A1 only.',
    }
    e.write_json(root/'LiH_local_refine_decision.json', decision)
    lines = [f'LiH / aug-cc-pVTZ local refinement: {decision["status"]}',
             f'Reason: {reason}', f'Local factor={last["local_refinement_factor"]}; edges={last["number_of_edges"]}',
             f'C={last["C"]:.12e}; D_mu={last["D_mu"]:.12e}',
             f'eta={last["eta"]:.10f}; leakage={last["leakage"]:.6e}; margin={last["assignment_margin"]:.8f}',
             'Checks: '+json.dumps(checks),
             'Original result files and original REVIEW_REQUIRED decision are preserved.']
    (root/'SUMMARY.txt').write_text('\n'.join(lines)+'\n')
    return decision


def run(args, info):
    source, root = args.source.resolve(), args.root.resolve()
    if root == source or source in root.parents or root in source.parents:
        raise RuntimeError('--root and --source must be separate, non-nested directories')
    # Continuation and reanalysis use the registered runtime. An offline audit
    # can be performed separately without changing these checkpoint identities.
    if not info['runtime_matches_original']:
        raise RuntimeError('Use the original osmo4-mokit runtime for this supplement. Expected '+
                           json.dumps(info['plan']['plan']['runtime_versions'])+'; got '+json.dumps(runtime()))
    if args.command == 'analyze' and not (root/'plan.json').is_file():
        raise FileNotFoundError('No supplemental plan exists; run all first')
    root.mkdir(parents=True, exist_ok=True)
    import fcntl
    lock = (root/'run.lock').open('a')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        lock.close()
        raise RuntimeError('Another supplemental calculation is using '+str(root))
    registered = False
    try:
        register_plan(root, make_plan(info))
        registered = True
        e.MAX_MEMORY_MB = args.memory_mb
        e.lib.num_threads(args.threads)
        e.write_json(root/'run_status.json', {'status':'RUNNING', 'pid':os.getpid(), 'command':args.command})
        sols = freeze_baseline(source, root, info)
        # Include exact source files in the result archive for future independent analysis.
        for p in (Path(__file__), Path(e.__file__)):
            copy_verified(p, root/'code'/p.name, e.sha256(p))
        e.write_json(root/'selftest.json', e.selftest())
        baseline = analyze(refined_path(1), sols, 1)
        old16 = next(r for r in read_json(source/'loop_results.json') if r['scale'] == 1 and r['segments_per_side'] == 16)
        if max(abs(baseline[k]-old16[k]) for k in ('C','D_mu')) > 1e-11:
            raise RuntimeError('Recomputed baseline does not match the original report')
        e.write_json(root/'analysis'/'baseline_n16.json', baseline)
        previous = baseline
        loops, comparisons, histories = [], [], []
        reason = 'Maximum local refinement reached without all qualification checks passing.'
        for factor in FACTORS:
            ps = refined_path(factor)
            missing_keys = [k for k in ps[:-1] if k not in sols]
            for i, key in enumerate(missing_keys, 1):
                sols[key] = e.get_solution(e.outpath(root/'solutions', key), key, 'direct',
                                           analyze_only=args.command == 'analyze')
                print(f'PROGRESS direct factor={factor} {i}/{len(missing_keys)}', flush=True)
            current = analyze(ps, sols, factor)
            comparison = mesh_comparison(previous, current)
            loops.append(current)
            comparisons.append(comparison)
            e.write_json(root/'analysis'/f'loop_factor_{factor:03d}.json', current)
            e.write_json(root/'mesh_comparisons.json', comparisons)
            print(f'LOOP factor={factor} edges={len(ps)-1} C={current["C"]:.12e} margin={current["assignment_margin"]:.8f} qualified={current["qualified"]} stable={comparison["pass"]}', flush=True)
            previous = current
            # At least two NEW refinement levels are required. Original n=16
            # cannot be used as the coarse member of the acceptance pair.
            if factor < 4 or not comparison['pass']:
                continue
            histories = run_histories(root, ps, sols, current, factor, args.command == 'analyze')
            if all(h['history_pass'] for h in histories):
                reason = 'Two successive local refinements and complete opposed histories passed; inspect inherited and original-n16 comparisons in checks.'
                break
            other_failure = any(not all(v for k, v in h['checks'].items() if k != 'assignment_margin')
                                or not all(h['history_checks'].values()) for h in histories)
            if other_failure:
                reason = 'Supplemental history controls failed beyond an assignment-margin-only issue; manual review required.'
                break
            print('History failure is assignment-margin-only; continuing the predeclared refinement ladder.', flush=True)
        decision = write_summary(root, info, baseline, loops, comparisons, histories, reason)
        files = {str(p.relative_to(root)): e.sha256(p) for p in sorted(root.rglob('*.npz'))}
        e.write_json(root/'wavefunction_sha256.json', files)
        e.write_json(root/'run_status.json', {'status':'COMPLETED', 'scientific_status':decision['status'], 'wavefunctions':len(files)})
        print((root/'SUMMARY.txt').read_text(), flush=True)
        return 0 if decision['status'] == 'QUALIFIED' else 2
    except BaseException as exc:
        # Do not replace a valid status merely because registration itself failed.
        if registered:
            e.write_json(root/'run_status.json', {'status':'FAILED_OR_INTERRUPTED', 'error':repr(exc), 'traceback':traceback.format_exc()})
        raise
    finally:
        lock.close()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command', nargs='?', choices=('all','check','analyze'), default='all')
    parser.add_argument('--source', type=Path, required=True, help='Original unpacked 022058 result directory')
    parser.add_argument('--root', type=Path, default=Path(__file__).resolve().parent/'LiH_augccpVTZ_local_refine_work')
    parser.add_argument('--threads', type=int, default=8)
    parser.add_argument('--memory-mb', type=int, default=8000)
    args = parser.parse_args()
    if args.threads < 1 or args.memory_mb < 500:
        parser.error('threads must be >=1 and memory-mb >=500')
    e.lib.num_threads(args.threads)
    info = inspect_source(args.source.resolve())
    if args.command == 'check':
        print(json.dumps({'source_integrity':'PASS', 'runtime_matches_original':info['runtime_matches_original'],
                          'required_runtime':info['plan']['plan']['runtime_versions'], 'actual_runtime':runtime(),
                          'refined_edges':LOCAL_EDGES,
                          'meshes':[{'factor':n, 'edges':len(refined_path(n))-1,
                                     'new_independent_points_cumulative':6*(n-1),
                                     'history_points_if_selected':2*len(refined_path(n))} for n in FACTORS]}, indent=2))
        return 0 if info['runtime_matches_original'] else 2
    return run(args, info)


if __name__ == '__main__':
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print('Interrupted. Re-run the identical command to resume.', file=sys.stderr)
        sys.exit(130)
